+    private func runRowBacking(completion: @escaping () -> Void) {
+        guard let window = self.controller?.genericView.tableView.window, let root = window.contentView else {
+            completion()
+            return
+        }
+        let previousLevel = window.level
+        window.level = .floating
+        window.orderFrontRegardless()
+        let rounds = Int(self.configuration.double("-PerfLabRowBackingRounds", 3))
+        let wait = self.configuration.double("-PerfLabParityWait", 0.5)
+        var compared = 0, equal = 0, different = 0, unstable = 0, rows = 0, legacyContents = 0, layerContents = 0
+        var details: [String] = []
+        func rowViews(_ view: NSView, into result: inout [TableRowView]) {
+            if let row = view as? TableRowView, !row.isHiddenOrHasHiddenAncestor, !row.visibleRect.isEmpty {
+                result.append(row)
+            }
+            for subview in view.subviews {
+                rowViews(subview, into: &result)
+            }
+        }
+        func crop(_ image: CGImage, _ row: TableRowView) -> Data? {
+            let visible = row.convert(row.visibleRect, to: nil)
+            let scale = CGFloat(image.width) / window.frame.width
+            let rect = CGRect(x: visible.minX * scale, y: (window.frame.height - visible.maxY) * scale, width: visible.width * scale, height: visible.height * scale).integral
+            return image.cropping(to: rect).flatMap { self.pixels($0) }
+        }
+        func capture(legacy: Bool, done: @escaping ([ObjectIdentifier: Data], Int, CGImage?) -> Void) {
+            TableRowView.debugForcesBackingStore = legacy
+            var found: [TableRowView] = []
+            rowViews(root, into: &found)
+            rows = found.count
+            for row in found {
+                row.needsDisplay = true
+            }
+            window.displayIfNeeded()
+            CATransaction.flush()
+            Queue.mainQueue().after(wait, {
+                window.displayIfNeeded()
+                CATransaction.flush()
+                let withContents = found.filter { $0.layer?.contents != nil }.count
+                Queue.mainQueue().after(0.1, {
+                    var result: [ObjectIdentifier: Data] = [:]
+                    let image = self.windowImage(window)
+                    if let image {
+                        for row in found {
+                            result[ObjectIdentifier(row)] = crop(image, row)
+                        }
+                    }
+                    done(result, withContents, image)
+                })
+            })
+        }
+        func step(_ index: Int) {
+            guard index < rounds else {
+                TableRowView.debugForcesBackingStore = false
+                window.level = previousLevel
+                self.report.add(scenario: "rowbacking", run: 0, metrics: ["rowsCompared": Double(compared), "equal": Double(equal), "different": Double(different), "unstable": Double(unstable), "rowViews": Double(rows), "legacyRowsWithContents": Double(legacyContents), "layerRowsWithContents": Double(layerContents)], notes: ["different": details.joined(separator: "; ")])
+                completion()
+                return
+            }
+            capture(legacy: true, done: { first, firstContents, firstImage in
+                capture(legacy: false, done: { candidate, candidateContents, candidateImage in
+                    capture(legacy: true, done: { second, _, _ in
+                        capture(legacy: false, done: { candidateSecond, _, _ in
+                            legacyContents = firstContents
+                            layerContents = candidateContents
+                            var differs = false
+                            for (key, a) in first {
+                                guard let b = candidate[key], let c = second[key], let d = candidateSecond[key] else { continue }
+                                compared += 1
+                                if a != c || b != d {
+                                    unstable += 1
+                                } else if a == b {
+                                    equal += 1
+                                } else {
+                                    different += 1
+                                    differs = true
+                                }
+                            }
+                            if differs, let firstImage, let candidateImage {
+                                details.append("round \(index)")
+                                self.savePNG(firstImage, name: "rowbacking\(index)-legacy")
+                                self.savePNG(candidateImage, name: "rowbacking\(index)-layers")
+                            }
+                            step(index + 1)
+                        })
+                    })
+                })
+            })
+        }
+        step(0)
+    }
