+    static func hit(_ frame: NSRect, verify: () -> NSRect) {
+        hits += 1
+        guard verifies else { return }
+        let fresh = verify()
+        if fresh != frame {
+            mismatches += 1
+            if mismatchNotes.count < 8 {
+                mismatchNotes.append("\(frame)->\(fresh)")
+            }
+        }
+    }
+
+    static func take() -> (metrics: [String: Double], note: String) {
